# ── Server ──────────────────────────────────────────────────────────────
# Bind address. Keep 127.0.0.1 unless a reverse proxy fronts it.
HOST=127.0.0.1
PORT=3000
# Public URL used in copy-paste client configs (falls back to http://HOST:PORT).
# PUBLIC_URL=https://plexus.example.com

# ── Data ────────────────────────────────────────────────────────────────
# SQLite database + generated secrets live here. Back up this directory.
DATA_DIR=./data
# DATABASE_FILE=plexus.db

# ── Admin ───────────────────────────────────────────────────────────────
# Username created on first boot. Password is generated randomly and printed
# once in the server log unless you set it here (useful for CI/e2e).
PLEXUS_ADMIN_USERNAME=plexus
# PLEXUS_ADMIN_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=168
# Set true when serving over HTTPS (recommended for any non-local deployment).
COOKIE_SECURE=false
# Trust X-Forwarded-For when behind a reverse proxy.
TRUST_PROXY=false

# ── Gateway ─────────────────────────────────────────────────────────────
# Timeout for outbound tool calls.
UPSTREAM_TIMEOUT_MS=15000
# Hosts allowed to resolve to private addresses (local/LAN upstreams).
EGRESS_ALLOW_HOSTS=127.0.0.1,localhost
# Requests per second per token and tool.
RATE_LIMIT_PER_SEC=20
# Days to keep invocation logs.
INVOCATION_RETENTION_DAYS=90

# ── Built-in assistant (optional) ───────────────────────────────────────
# deepseek | openai | stub. Without MODEL_API_KEY the assistant stays hidden.
MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
MODEL_TIMEOUT_MS=120000
AGENT_MAX_STEPS=6

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Admin MCP (optional) ────────────────────────────────────────────────
# Enables POST /admin/mcp for management tools. Unset = disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_MCP_TOKEN=
