    "ajv": "^8.17.1",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "pino": "^9.5.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
